# Development environment
DATABASE_URL=postgres://postgres:postgres@localhost:5433/app_dev

CORS_ORIGIN=http://localhost:5173
PORT=8020

JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=24h

JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

SYSTEM_USER_ID=
SYSTEM_USER_PSEUDO=
SYSTEM_USER_EMAIL=
SYSTEM_USER_PASSWORD=

# Dev-only seeded data owner (useruser)
DEV_DATA_USER_ID=
DEV_DATA_USER_LOGIN=
DEV_DATA_USER_PASSWORD=
DEV_DATA_USER_EMAIL=

DEV_ADMIN_ID=
DEV_ADMIN_PSEUDO=
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=

# Optional: force dev demo data seeding even outside NODE_ENV=development
SEED_INCLUDE_DEV_DATA=false

# Optional remote URL to download image-index.json when local index is missing/invalid
STORAGE_IMAGE_INDEX_URL=

# Optional base URL used to fetch images remotely (when storage files are not local)
# Example: http://em.assets.test/images
STORAGE_IMAGE_BASE_URL=

# In-memory cache TTL for image index maps (milliseconds). Set 0 to force refresh each call.
STORAGE_IMAGE_INDEX_CACHE_TTL_MS=300000
