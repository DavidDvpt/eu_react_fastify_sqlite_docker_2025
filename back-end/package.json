{
  "name": "back-end",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "prisma:reset": "dotenv -e .env.dev -- npx prisma migrate reset --force",
    "prisma:migrate": "dotenv -e .env.dev -- npx prisma migrate dev --name",
    "prisma:deploy": "npx prisma migrate deploy",
    "prisma:deploy:dev": "dotenv -e .env.dev -- npx prisma migrate deploy",
    "prisma:generate": "npx prisma generate",
    "prisma:generate:dev": "dotenv -e .env.dev -- npx prisma generate",
    "prisma:seed": "npx prisma db seed",
    "prisma:seed:dev": "dotenv -e .env.dev -- npx prisma db seed",
    "test:all": "npm run test:db:migrate && npm run test",
    "prisma:sync": "npm run prisma:deploy && npm run prisma:generate",
    "dev:reset-and-seed": "npm run prisma:reset && npm run prisma:seed",
    "sql:extract": "tsx tools/sql-to-ts.ts",
    "test": "vitest --config vitest.api.config.ts",
    "test:api": "vitest run --config vitest.api.config.ts",
    "test:bdd": "bash ./scripts/test-db.sh",
    "test:bdd:raw": "vitest run --config vitest.bdd.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier \"src/**/*.{ts,tsx,js,json,md}\" --check",
    "format:fix": "prettier \"src/**/*.{ts,tsx,js,json,md}\" --write"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@prisma/adapter-pg": "^7.0.1",
    "@prisma/client": "^7.0.0",
    "argon2": "^0.41.1",
    "fastify": "^5.6.2",
    "fastify-type-provider-zod": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "prisma": "^7.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0",
    "vitest": "^4.0.15",
    "wait-on": "^9.0.3",
    "zod": "^4.1.13"
  }
}
