// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum LotType {
  SESSION_LINE
  TRANSACTION
  LOT
}

enum TransactionType {
  PURCHASE
  FOUND
  GIFT
  EXISTING_STOCK
  LOST
  GIVEN
}

enum TransactionStatus {
  SOLDED
  RETURNED
  RUNNING
}

enum TransactionLineType {
  GAIN
  LOST
}

model User {
  id            String  @id @default(uuid())
  firstname     String
  lastname      String
  pseudo        String  @unique
  password_hash String
  role          Role
  date_created  String
  date_updated  String?
  is_active     Boolean

  @@map("user")
}


model ItemCategory {
  id           String  @id @default(uuid())
  date_created String
  date_updated String?
  is_active    Boolean
  name         String  @unique

  item_types ItemType[]

  @@map("item_category")
}

model ItemType {
  id           String  @id @default(uuid())
  category_id  String
  date_created String
  date_updated String?
  is_active    Boolean
  name         String  @unique

  category ItemCategory @relation(fields: [category_id], references: [id], onDelete: Cascade)
  items    Item[]

  @@map("item_type")
}

model Item {
  id           String  @id @default(uuid())
  image_url_id String
  value        Decimal
  is_limited   Boolean
  item_type_id String
  date_created String
  date_updated String?
  is_active    Boolean
  name         String  @unique

  item_type    ItemType @relation(fields: [item_type_id], references: [id], onDelete: Cascade)
  inventory_lots InventoryLot[]
  transactions   Transaction[]

  @@map("item")
}

model InventoryLot {
  id                 String  @id @default(uuid())
  quantity_remaining Int
  quantity_exported  Int
  price_remaining    String
  item_id            String
  lot_type           LotType
  date_created       String
  date_updated       String?
  is_active          Boolean

  item  Item @relation(fields: [item_id], references: [id], onDelete: Cascade)
  links InventoryLotTransaction[]

  @@map("inventory_lot")
}

model Transaction {
  id               String @id @default(uuid())
  transaction_type TransactionType
  sell_status      TransactionStatus?
  quantity         Int
  tt_value         Decimal
  ttc_value        Decimal
  fee              Decimal?
  date_created     String
  date_updated     String?
  is_active        Boolean
  item_id          String

  item            Item @relation(fields: [item_id], references: [id], onDelete: Cascade)
  lots InventoryLotTransaction[]

  @@map("transaction")
}

model InventoryLotTransaction {
  inventory_lot_id String
  transaction_id   String
  quantity         Int

  inventory_lot    InventoryLot @relation(fields: [inventory_lot_id], references: [id], onDelete: Restrict)
  transaction   Transaction  @relation(fields: [transaction_id], references: [id], onDelete: Restrict)

  @@id([inventory_lot_id, transaction_id])

  @@map("inventory_lot_transaction")
}

model SeedPatch {
  id         String   @id @default(uuid())
  name       String   @unique
  patch_date DateTime @default(now())

  @@map("seed_patch")
}
