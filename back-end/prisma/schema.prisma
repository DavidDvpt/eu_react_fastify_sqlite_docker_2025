// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model ItemCategories {
  id           String  @id @default(uuid())
  date_created String
  date_updated String?
  is_active    Boolean
  name         String  @unique

  ItemTypes ItemTypes[]

  @@map("ItemCategories")
}

model user {
  id            String  @id @default(uuid())
  firstname     String
  lastname      String
  pseudo        String  @unique
  password_hash String
  role          Int
  date_created  String
  date_updated  String?
  is_active     Boolean

  @@map("user")
}

model ItemTypes {
  id           String  @id @default(uuid())
  category_id  String
  date_created String
  date_updated String?
  is_active    Boolean
  name         String  @unique

  category ItemCategories @relation(fields: [category_id], references: [id], onDelete: Cascade)
  Items    Items[]

  @@index([category_id], map: "IX_ItemTypes_category_id")
  @@map("ItemTypes")
}

model Items {
  id           String  @id @default(uuid())
  image_url_id String
  value        Decimal
  is_limited   Boolean
  item_type_id String
  date_created String
  date_updated String?
  is_active    Boolean
  name         String  @unique

  itemType      ItemTypes       @relation(fields: [item_type_id], references: [id], onDelete: Cascade)
  InventoryLots InventoryLots[]
  Transactions  Transactions[]

  @@index([item_type_id], map: "IX_Items_item_type_id")
  @@map("Items")
}

model InventoryLots {
  id                 String  @id @default(uuid())
  quantity_remaining Int
  quantity_exported  Int
  price_remaining    String
  item_id            String
  lot_type           Int
  date_created       String
  date_updated       String?
  is_active          Boolean

  item                     Items                      @relation(fields: [item_id], references: [id], onDelete: Cascade)
  InventoryLotTransactions InventoryLotTransactions[]

  @@index([item_id], map: "IX_InventoryLots_item_id")
  @@map("InventoryLots")
}

model Transactions {
  id               String   @id @default(uuid())
  transaction_type Int
  sell_status      Int?
  quantity         Int
  tt_value         Decimal
  ttc_value        Decimal
  fee              Decimal?
  date_created     String
  date_updated     String?
  is_active        Boolean
  item_id          String

  item                     Items                      @relation(fields: [item_id], references: [id], onDelete: Cascade)
  InventoryLotTransactions InventoryLotTransactions[]

  @@index([item_id], map: "IX_Transactions_item_id")
  @@map("Transactions")
}

model InventoryLotTransactions {
  inventory_lot_id String
  transaction_id   String
  Quantity         Int

  inventoryLot InventoryLots @relation(fields: [inventory_lot_id], references: [id])
  transaction  Transactions  @relation(fields: [transaction_id], references: [id])

  @@id([inventory_lot_id, transaction_id])
  @@index([transaction_id], map: "IX_InventoryLotTransactions_transaction_id")
  @@map("InventoryLotTransactions")
}
