// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum LotType {
  SESSION_LINE
  TRANSACTION
  LOT
}

enum TransactionType {
  PURCHASE
  FOUND
  GIFT
  EXISTING_STOCK
  SELL
  GIVEN
}

enum TransactionStatus {
  SOLDED
  RETURNED
  RUNNING
}

enum TransactionLineType {
  GAIN
  LOST
}

enum SessionType {
  TRADE
  MINING
  CRAFTING
}

enum SessionStatus {
  OPENNED
  CLOSED
  ARCHIVED
}

enum SessionLineType {
  IN
  OUT
}

model User {
  id                       String                    @id @default(uuid())
  firstname                String?
  lastname                 String?
  pseudo                   String                    @unique
  email                    String                    @unique
  password_hash            String
  role                     Role
  date_created             String
  date_updated             String?
  is_active                Boolean                   @default(true)
  itemCategories           ItemCategory[]
  itemTypes                ItemType[]
  items                    Item[]
  transactions             Transaction[]
  inventoryLots            InventoryLot[]
  inventoryLotTransactions InventoryLotTransaction[]
  sessions                 Session[]
  sessionLines             SessionLine[]

  @@map("user")
}

model Session {
  id           String        @id @default(uuid())
  cost_tt      Decimal       @default(0)
  cost_ttc     Decimal       @default(0)
  win_tt       Decimal       @default(0)
  win_ttc      Decimal       @default(0)
  session_type SessionType
  clics        Int           @default(0)
  status       SessionStatus @default(OPENNED)
  user_id      String

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  lines SessionLine[]

  @@index([user_id])
  @@map("session")
}

model SessionLine {
  id               String             @id @default(uuid())
  session_id       String
  item_id          String
  inventory_lot_id String?
  quantity         Int
  line_type        SessionLineType
  line_status      SessionStatus      @default(OPENNED)
  sale_status      TransactionStatus?
  tt               Decimal            @default(0)
  ttc              Decimal            @default(0)
  user_id          String

  session Session @relation(fields: [session_id], references: [id], onDelete: Cascade)
  item    Item    @relation(fields: [item_id], references: [id], onDelete: Cascade)
  lot     InventoryLot? @relation(fields: [inventory_lot_id], references: [id], onDelete: SetNull)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([session_id])
  @@index([item_id])
  @@index([inventory_lot_id])
  @@index([user_id])
  @@map("session_line")
}

model ItemCategory {
  id           String  @id @default(uuid())
  date_created String
  date_updated String?
  is_active    Boolean @default(true)
  name         String  @unique
  user_id      String

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  item_types ItemType[]

  @@map("item_category")
}

model ItemType {
  id               String  @id @default(uuid())
  category_id      String
  date_created     String
  date_updated     String?
  is_active        Boolean @default(true)
  is_stackable     Boolean @default(false)
  supports_limited Boolean @default(false)
  user_id          String
  name             String  @unique

  category ItemCategory @relation(fields: [category_id], references: [id], onDelete: Cascade)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  items Item[]

  @@map("item_type")
}

model Item {
  id           String  @id @default(uuid())
  image_url_id String
  value        Decimal
  is_limited   Boolean
  item_type_id String
  user_id      String
  date_created String
  date_updated String?
  is_active    Boolean @default(true)
  is_stackable Boolean @default(true)
  name         String  @unique

  item_type ItemType @relation(fields: [item_type_id], references: [id], onDelete: Cascade)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  inventory_lots InventoryLot[]

  transactions Transaction[]
  session_lines SessionLine[]

  @@map("item")
}

model InventoryLot {
  id                 String  @id @default(uuid())
  quantity_remaining Int
  quantity_exported  Int
  price_remaining    String
  item_id            String
  lot_type           LotType
  date_created       String
  date_updated       String?
  is_active          Boolean @default(true)

  user_id String?
  user    User?   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  item  Item                      @relation(fields: [item_id], references: [id], onDelete: Cascade)
  line  SessionLine[]
  links InventoryLotTransaction[]

  @@map("inventory_lot")
}

model Transaction {
  id               String             @id @default(uuid())
  transaction_type TransactionType
  sell_status      TransactionStatus?
  quantity         Int
  tt_value         Decimal
  ttc_value        Decimal
  fee              Decimal?
  date_created     String
  date_updated     String?
  is_active        Boolean
  item_id          String

  item Item @relation(fields: [item_id], references: [id], onDelete: Cascade)

  user_id String?
  user    User?   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  lots InventoryLotTransaction[]

  @@map("transaction")
}

model InventoryLotTransaction {
  inventory_lot_id String
  transaction_id   String
  quantity         Int

  inventory_lot InventoryLot @relation(fields: [inventory_lot_id], references: [id], onDelete: Restrict)

  user_id String?
  user    User?   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  transaction Transaction @relation(fields: [transaction_id], references: [id], onDelete: Restrict)

  @@id([inventory_lot_id, transaction_id])
  @@map("inventory_lot_transaction")
}

model SeedPatch {
  id         String   @id @default(uuid())
  name       String   @unique
  patch_date DateTime @default(now())

  @@map("seed_patch")
}
