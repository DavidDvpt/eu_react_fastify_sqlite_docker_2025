// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model item_categories {
  id           String         @id @default(uuid())
  date_created String
  date_updated String?
  is_active    Int
  name         String         @unique

  item_types   item_types[]
}

model user {
  id           String  @id @default(uuid())
  firstname    String
  lastname     String
  pseudo       String  @unique
  password_hash String
  role         Int
  date_created String
  date_updated String?
  is_active    Int
}

model item_types {
  id           String             @id @default(uuid())
  category_id  String
  date_created String
  date_updated String?
  is_active    Int
  name         String             @unique

  category     item_categories    @relation(fields: [category_id], references: [id], onDelete: Cascade)
  items        items[]
}

model items {
  id           String        @id @default(uuid())
  image_url_id String
  value        Decimal
  is_limited   Int
  item_type_id String
  date_created String
  date_updated String?
  is_active    Int
  name         String        @unique

  item_type    item_types    @relation(fields: [item_type_id], references: [id], onDelete: Cascade)
  inventory_lots inventory_lots[]
  transactions   transactions[]
}

model inventory_lots {
  id                String     @id @default(uuid())
  quantity_remaining Int
  quantity_exported Int
  price_remaining   String
  item_id           String
  lot_type          Int
  date_created      String
  date_updated      String?
  is_active         Int

  item              items      @relation(fields: [item_id], references: [id], onDelete: Cascade)
  links             inventory_lot_transactions[]
}

model transactions {
  id              String      @id @default(uuid())
  transaction_type Int
  sell_status      Int?
  quantity         Int
  tt_value         Decimal
  ttc_value        Decimal
  fee              Decimal?
  date_created     String
  date_updated     String?
  is_active        Int
  item_id          String

  item             items       @relation(fields: [item_id], references: [id], onDelete: Cascade)
  lots             inventory_lot_transactions[]
}

model inventory_lot_transactions {
  inventory_lot_id String
  transaction_id   String
  quantity         Int

  inventory_lot inventory_lots @relation(fields: [inventory_lot_id], references: [id], onDelete: Restrict)
  transaction   transactions   @relation(fields: [transaction_id], references: [id], onDelete: Restrict)

  @@id([inventory_lot_id, transaction_id])
}
