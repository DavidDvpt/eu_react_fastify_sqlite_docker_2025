FROM node:24-alpine3.22 AS deps
WORKDIR /app/back-end
COPY apps/back-end/package*.json ./
RUN npm ci

FROM deps AS build
WORKDIR /app/back-end
COPY apps/back-end/ ./
RUN npm run build
RUN npx prisma generate

FROM node:24-alpine3.22 AS runtime
WORKDIR /app/back-end
ENV NODE_ENV=production

RUN apk update && apk upgrade --no-cache
RUN apk add --no-cache postgresql-client

COPY apps/back-end/package*.json ./
RUN npm ci

COPY --from=build /app/back-end/dist ./dist
COPY --from=build /app/back-end/prisma ./prisma
COPY --from=build /app/back-end/prisma.config.ts ./prisma.config.ts
COPY --from=build /app/back-end/src/config ./src/config
COPY --from=build /app/back-end/scripts ./scripts

EXPOSE 8020

CMD ["sh", "-c", "npx prisma migrate deploy && node dist/prisma/seed.js && node dist/src/server.js"]
