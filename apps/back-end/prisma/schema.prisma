// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum LotType {
  MINING
  CRAFTING
  TRADE
  REFINING
}

enum TransactionType {
  BUY
  FOUND
  GIFT
  EXISTING_STOCK
  SELL
  GIVEN
}

enum TransactionStatus {
  SOLDED
  RETURNED
  RUNNING
  CANCELED
}

enum TransactionLineType {
  GAIN
  LOST
}

enum SessionType {
  TRANSACTION
  MINING
  CRAFTING
}

enum SessionStatus {
  OPENNED
  CLOSED
  ARCHIVED
}

enum SessionLineType {
  IN
  OUT
}

enum PedCardTupleType {
  INITIAL_BALANCE
  BUY_TTC
  BUY_FEE
  SELL_TTC
  SELL_FEE
  ADJUSTMENT
}

model User {
  id             String        @id @default(uuid())
  firstname      String?
  lastname       String?
  pseudo         String        @unique
  email          String        @unique
  password_hash  String
  role           Role
  date_created   String
  date_updated   String?
  is_active      Boolean       @default(true)
  itemCategories Category[]
  itemTypes      Type[]
  items          Item[]
  lots           Lot[]
  transactions   Transaction[]
  pedCardEntries PedCard[]

  @@map("user")
}

model PedCard {
  id             String  @id @default(uuid())
  user_id        String
  transaction_id String?
  type           String
  value          Decimal
  created_at     String
  updated_at     String?

  user        User         @relation(fields: [user_id], references: [id])
  transaction Transaction? @relation(fields: [transaction_id], references: [id])

  @@unique([transaction_id, type])
  @@map("pedcard")
}

model Transaction {
  id               String             @id @default(uuid())
  tt               Decimal            @default(0)
  fee              Decimal            @default(0)
  ttc              Decimal            @default(0)
  transaction_type TransactionType
  status           TransactionStatus?
  created_at       String
  updated_at       String?
  user_id          String

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  lines          TransactionLot[]
  pedCardEntries PedCard[]

  @@index([user_id, status])
  @@map("transaction")
}

model TransactionLot {
  transaction_id String
  lot_id         String
  quantity       Int
  transaction    Transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)
  lot            Lot         @relation(fields: [lot_id], references: [id])

  @@unique([transaction_id, lot_id])
  @@map("transaction_lot")
}

model Category {
  id           String  @id @default(uuid())
  date_created String
  date_updated String?
  is_active    Boolean @default(true)
  name         String  @unique
  user_id      String

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  item_types Type[]

  @@map("item_category")
}

model Type {
  id           String  @id @default(uuid())
  category_id  String
  date_created String
  date_updated String?
  is_active    Boolean @default(true)
  is_stackable Boolean @default(false)
  user_id      String
  name         String  @unique

  category Category @relation(fields: [category_id], references: [id], onDelete: Cascade)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  items       Item[]
  nexusUpdate NexusUpdate?

  @@map("item_type")
}

model Item {
  id             String   @id @default(uuid())
  image_url_id   String
  value          Decimal
  is_limited     Boolean
  type_id        String
  user_id        String
  date_created   String
  date_updated   String?
  is_active      Boolean  @default(true)
  name           String   @unique
  nexus_id       String?
  description    String?
  weight         Decimal?
  decay          Decimal?
  is_untradeable Boolean?
  is_rare        Boolean?

  item_type Type @relation(fields: [type_id], references: [id], onDelete: Cascade)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  lots Lot[]

  finderDetail    FinderDetail?
  excavatorDetail ExcavatorDetail?
  refinerDetail   RefinerDetail?

  @@map("item")
}

model FinderDetail {
  id             String   @id
  depth          Decimal?
  use_per_minute Decimal?
  nexus_url      String?
  ammo_burn      Decimal?

  item Item @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("finder_detail")
}

model ExcavatorDetail {
  id             String   @id
  Efficienty     Decimal?
  range          Decimal?
  use_per_minute Decimal?
  nexus_url      String?

  item Item @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("excavator_detail")
}

model RefinerDetail {
  id             String   @id
  use_per_minute Decimal?
  nexus_url      String?

  item Item @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("refiner_detail")
}

model Lot {
  id                 String  @id @default(uuid())
  quantity_remaining Int
  quantity_exported  Int
  price_remaining    Float?  @default(0)
  item_id            String
  lot_type           LotType
  date_created       String
  date_updated       String?
  is_active          Boolean @default(true)
  user_id            String?
  user               User?   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  item             Item             @relation(fields: [item_id], references: [id], onDelete: Cascade)
  transaction_lots TransactionLot[]

  @@map("lot")
}

model NexusUpdate {
  id                  String  @id @unique
  nexus_request_type  String?
  nexus_name          String?
  item_count          Int     @default(0)
  image_missing_count Int     @default(0)
  change_count        Int     @default(0)
  created_at          String
  inserted_at         String?
  updated_at          String?

  type Type @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("nexus_update")
}

model SeedPatch {
  id         String   @id @default(uuid())
  name       String   @unique
  patch_date DateTime @default(now())

  @@map("seed_patch")
}
