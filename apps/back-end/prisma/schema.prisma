// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum LotType {
  MINING
  CRAFTING
  TRADE
  REFINING
}

enum TransactionType {
  BUY
  FOUND
  GIFT
  EXISTING_STOCK
  SELL
  GIVEN
}

enum TransactionStatus {
  SOLDED
  RETURNED
  RUNNING
}

enum TransactionLineType {
  GAIN
  LOST
}

enum SessionType {
  TRANSACTION
  MINING
  CRAFTING
}

enum SessionStatus {
  OPENNED
  CLOSED
  ARCHIVED
}

enum SessionLineType {
  IN
  OUT
}

enum PedCardTupleType {
  INITIAL_BALANCE
  BUY_TTC
  BUY_FEE
  SELL_TTC
  SELL_FEE
  ADJUSTMENT
}

model User {
  id             String        @id @default(uuid())
  firstname      String?
  lastname       String?
  pseudo         String        @unique
  email          String        @unique
  password_hash  String
  role           Role
  date_created   String
  date_updated   String?
  is_active      Boolean       @default(true)
  itemCategories Category[]
  itemTypes      Type[]
  items          Item[]
  lots           Lot[]
  sessions       Session[]
  sessionLines   SessionLine[]
  sessionLots    SessionLot[]
  transactions   Transaction[]
  pedCardEntries PedCard[]

  @@map("user")
}

model PedCard {
  id             String    @id @default(uuid())
  user_id        String
  transaction_id String?
  type           String
  value          Decimal
  created_at     DateTime  @default(now())
  updated_at     DateTime?

  user        User         @relation(fields: [user_id], references: [id])
  transaction Transaction? @relation(fields: [transaction_id], references: [id])

  @@unique([transaction_id, type])
  @@map("pedcard")
}

model Session {
  id           String        @id @default(uuid())
  cost_tt      Decimal       @default(0)
  cost_ttc     Decimal       @default(0)
  win_tt       Decimal       @default(0)
  win_ttc      Decimal       @default(0)
  session_type SessionType
  clics        Int           @default(0)
  status       SessionStatus @default(OPENNED)
  user_id      String

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  lines SessionLine[]
  lots  SessionLot[]

  @@index([user_id])
  @@map("session")
}

model SessionLine {
  id               String             @id @default(uuid())
  session_id       String
  item_id          String
  inventory_lot_id String?
  quantity         Int
  line_type        SessionLineType
  line_status      SessionStatus      @default(OPENNED)
  sale_status      TransactionStatus?
  tt               Decimal            @default(0)
  ttc              Decimal            @default(0)
  user_id          String

  session Session @relation(fields: [session_id], references: [id], onDelete: Cascade)
  item    Item    @relation(fields: [item_id], references: [id], onDelete: Cascade)
  lot     Lot?    @relation(fields: [inventory_lot_id], references: [id], onDelete: SetNull)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([session_id])
  @@index([item_id])
  @@index([inventory_lot_id])
  @@index([user_id])
  @@map("session_line")
}

model SessionLot {
  id               String             @id @default(uuid())
  session_id       String
  item_id          String
  inventory_lot_id String?
  quantity         Int
  line_type        SessionLineType
  line_status      SessionStatus      @default(OPENNED)
  sale_status      TransactionStatus?
  tt               Decimal            @default(0)
  ttc              Decimal            @default(0)
  user_id          String

  session Session @relation(fields: [session_id], references: [id], onDelete: Cascade)
  item    Item    @relation(fields: [item_id], references: [id], onDelete: Cascade)
  lot     Lot?    @relation(fields: [inventory_lot_id], references: [id], onDelete: SetNull)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([session_id])
  @@index([item_id])
  @@index([inventory_lot_id])
  @@index([user_id])
  @@map("session_lot")
}

model Transaction {
  id               String             @id @default(uuid())
  tt               Decimal            @default(0)
  fee              Decimal            @default(0)
  ttc              Decimal            @default(0)
  transaction_type TransactionType
  status           TransactionStatus?
  created_at       DateTime           @default(now())
  updated_at       DateTime?
  user_id          String

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  lines          TransactionLot[]
  pedCardEntries PedCard[]

  @@index([user_id, status])
  @@map("transaction")
}

model TransactionLot {
  transaction_id String
  lot_id         String
  quantity       Int

  transaction Transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)
  lot         Lot         @relation(fields: [lot_id], references: [id])

  @@unique([transaction_id, lot_id])
  @@map("transaction_lot")
}

model Category {
  id           String  @id @default(uuid())
  date_created String
  date_updated String?
  is_active    Boolean @default(true)
  name         String  @unique
  user_id      String

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  item_types Type[]

  @@map("item_category")
}

model Type {
  id           String  @id @default(uuid())
  category_id  String
  date_created String
  date_updated String?
  is_active    Boolean @default(true)
  is_stackable Boolean @default(false)
  user_id      String
  name         String  @unique

  category Category @relation(fields: [category_id], references: [id], onDelete: Cascade)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  items Item[]

  @@map("item_type")
}

model Item {
  id           String  @id @default(uuid())
  image_url_id String
  value        Decimal
  is_limited   Boolean
  type_id      String
  user_id      String
  date_created String
  date_updated String?
  is_active    Boolean @default(true)
  name         String  @unique

  item_type Type @relation(fields: [type_id], references: [id], onDelete: Cascade)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  lots Lot[]

  session_lines SessionLine[]
  session_lots  SessionLot[]

  @@map("item")
}

model Lot {
  id                 String  @id @default(uuid())
  quantity_remaining Int
  quantity_exported  Int
  price_remaining    Float?  @default(0)
  item_id            String
  lot_type           LotType
  date_created       String
  date_updated       String?
  is_active          Boolean @default(true)

  user_id String?
  user    User?   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  item             Item             @relation(fields: [item_id], references: [id], onDelete: Cascade)
  line             SessionLine[]
  session_lots     SessionLot[]
  transaction_lots TransactionLot[]

  @@map("lot")
}

model SeedPatch {
  id         String   @id @default(uuid())
  name       String   @unique
  patch_date DateTime @default(now())

  @@map("seed_patch")
}
