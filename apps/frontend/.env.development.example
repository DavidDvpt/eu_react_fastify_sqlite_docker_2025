# Front-end development environment
# Backend API base URL (no trailing slash)
VITE_API_URL=http://localhost:8020

# OpenAPI spec URL (used by `npm run api:generate` to generate the API types)
VITE_OPENAPI_URL=http://localhost:8020/openapi.json

# Optional override for static item images base URL (no trailing slash)
# Example: http://em.assets.test/images
VITE_IMAGE_BASE_URL=

# Optional: demo account hints for local manual testing
VITE_DEV_USER_PSEUDO=
VITE_DEV_USER_EMAIL=
VITE_DEV_USER_PASSWORD=

VITE_DEV_ADMIN_PSEUDO=
VITE_DEV_ADMIN_EMAIL=
VITE_DEV_ADMIN_PASSWORD=
